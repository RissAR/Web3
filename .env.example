# ========================================================
# Конфігурація середовища (Environment Configuration)
# Скопіюйте цей файл у .env: cp .env.example .env
# ========================================================

# 1. Параметри бази даних PostgreSQL
POSTGRES_USER=lead_admin
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=lead_hub_db
POSTGRES_PORT=5432

# 2. Параметри n8n
# Якщо використовується домен із SSL через Cloudflare / Reverse Proxy:
# N8N_HOST=n8n.yourdomain.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_PORT_BIND=5678

# Ключ шифрування облікових записів n8n (згенерувати через: openssl rand -hex 16)
N8N_ENCRYPTION_KEY=generate_hex_32_chars_key_here

# Часовий пояс
TIMEZONE=Europe/Kyiv

# 3. Telegram Bot (для майбутнього підключення)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here

# 4. AI API (DeepSeek / OpenAI)
OPENAI_API_KEY=your_openai_or_deepseek_key
